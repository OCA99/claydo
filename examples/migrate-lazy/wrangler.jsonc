{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "migrate-lazy-example",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      { "name": "LIMITER_DO", "class_name": "LimiterDO" },
      { "name": "OLD_BUCKETS", "class_name": "OldBucket" },
      { "name": "OLD_SESSIONS", "class_name": "OldSession" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LimiterDO", "OldBucket", "OldSession"]
    }
  ]
}
