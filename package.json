{
  "name": "claydo",
  "version": "0.3.0",
  "description": "One Durable Object class, many use cases. Each instance routes to a fixed kind, and each kind runs in its own isolated storage facet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OCA99/claydo.git"
  },
  "homepage": "https://github.com/OCA99/claydo#readme",
  "bugs": {
    "url": "https://github.com/OCA99/claydo/issues"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "durable-objects",
    "durable-object-facets",
    "cloudflare-workers"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:examples": "for c in examples/*/vitest.config.ts; do vitest run --config \"$c\" || exit 1; done",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=5.20260815.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260819.1",
    "partyserver": "^0.5.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.124.0"
  }
}
