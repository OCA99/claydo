{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claydo-example-migrate-gnarly",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      { "name": "APP_DO", "class_name": "AppDO" },
      { "name": "OLD_GNARLY", "class_name": "LegacyGnarly" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AppDO", "LegacyGnarly"] }
  ]
}
