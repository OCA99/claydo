{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claydo-example-migrate-fleet",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      { "name": "APP_DO", "class_name": "AppDO" },
      { "name": "OLD_SESSIONS", "class_name": "OldSession" },
      { "name": "SECURE_DO", "class_name": "SecureDO" },
      { "name": "OLD_SECURE", "class_name": "OldSecureSession" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AppDO", "OldSession", "SecureDO", "OldSecureSession"]
    }
  ]
}
