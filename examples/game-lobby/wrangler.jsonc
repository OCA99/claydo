{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gdo-example-game-lobby",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      { "name": "APP_DO", "class_name": "AppDO" },
      { "name": "METRICS_DO", "class_name": "MetricsDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AppDO", "MetricsDO"] }
  ]
}
